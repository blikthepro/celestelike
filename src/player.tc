type plr:{
    name:str,
    maxdashes:num,
    dashes:num,
    maxstamina:num,
    stamina:num,
    state:str,
    refilldash:str,
    refillstam:str
};

extend plr{
    function constructor(): plr {

        line p = {
            name:'%uuid',
            maxdashes:1,
            dashes:1,
            maxstamina:110,
            stamina:110,
            state:"normal",
            refilldash:'true',
            refillstam:'true'
        } as plr;
        return p;
    }
    //some of these should be moved to their own files and leave the constructor alone

    function dash(this:var[plr]){ //this is how you make the class method work, no other way as far as i can tell
        if (this['state']=='dead'){
            return;
        }
        if (this['dashes']<1){
            return;
        }
        this['state']='dashing';

        line v = default.velocity;
        v.y=0;
        default.launchForward(num.clamp(vec.len(v)*10, 10, 1000), addToCurrentVel="False");
        this['dashes']--;
        allPlayers.playSound(snd2("celestelike:dash"), default.location);
    }

    function filteredRegen(this:var[plr]){
        if (this['dashes']<this['maxdashes']){
            this['dashes']=this['maxdashes'];
        }
        if (this['stamina']<this['maxstamina']){
            this['stamina']=this['maxstamina'];
        }
        this['state']='normal';
    }



    function jumpKeyFilter(this:var[plr]){
        if (this['state']=='grab'){

        }
        if (this['state']!=['grabjump', 'grab']){
            this.walljump();
        }
    }

    function walljump(this:var[plr]){
        if (player.isGrounded()){
            return;
        }
        if (player.isSwimming()){
            return;
        }
        line wjpoints= [vec(.5,0,0),vec(0,0,.5),vec(-.5,0,0),vec(0,0,-.5)];

    }
}