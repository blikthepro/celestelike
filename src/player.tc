type plr:{
    name:str,
    maxdashes:num,
    dashes:num,
    maxstamina:num,
    stamina:num,
    state:str
};

extend plr{
    function constructor(): plr {

        line p = {
            name:'%uuid',
            maxdashes:1,
            dashes:1,
            maxstamina:110,
            stamina:110,
            state:"normal"
        } as plr;
        return p;
    }

    function dash(this:var[plr]){
        if (this['state']=='dead'){
            return;
        }
        if (this['dashes']<1){
            return;
        }
        this['state']='dashing';

        line v = default.velocity;
        v.y=0;
        default.launchForward(num.clamp(vec.len(v)*10, 10, 1000), addToCurrentVel="False");
        this['dashes']--;
        allPlayers.playSound(csnd('celestelike:dash'), default.location);
        print(this);
    }

    function filteredRegen(this:var[plr]){
        if (this['dashes']<this['maxdashes']){
            this['dashes']=this['maxdashes'];
        }
        if (this['stamina']<this['maxstamina']){
            this['stamina']=this['maxstamina'];
        }
        this['state']='normal';
    }

    function hud(this:plr){
        selected.sendActionBar(this['state']);
    }
}