type plr:{
    name:str,
    maxdashes:num,
    dashes:num,
    maxstamina:num,
    stamina:num,
    state:str,
    refillDash:str,
    refillStam:str
};

extend plr{
    function constructor(): plr {

        line p = {
            name:'%uuid',
            maxdashes:1,
            dashes:1,
            maxstamina:110,
            stamina:110,
            state:"normal",
            refillDash:'true',
            refillStam:'true'
        } as plr;
        return p;
    }
    //some of these should be moved to their own files and leave the constructor alone

    process delayedStateReset(this:var[plr],time:num){
        line temp= this['state'];
        wait(time);
        if (this['state']==temp){
            this['state']='normal';
        }
    }

    function dash(this:var[plr]){ //this is how you make the class method work, no other way as far as i can tell
        if (this['state']=='dead'){
            return;
        }
        if (this['dashes']<1){
            return;
        }
        this['state']='dashing';

        default.launchForward(
            num.clamp(
                vec.len(
                    vec(
                        default.velocity.x,
                        0,
                        default.velocity.z
                    ))*10, 10, 1000), addToCurrentVel="False");
        
        this['dashes']--;
        allPlayers.playSound(snd2("celestelike:dash"), default.location);
        start this.delayedStateReset(this,5);
    }

    function filteredRegen(this:var[plr]){
        if (this['state']=='dashing'){
            return;
        }
        if(this['refillDash']=='true'){
            if (this['dashes']<this['maxdashes']){
                this['dashes']=this['maxdashes'];
            }
        }
        if(this['refillStam']=='true'){
            if (this['stamina']<this['maxstamina']){
                this['stamina']=this['maxstamina'];
            }
        }
        this['state']='normal';
    }



    function jumpKeyFilter(this:var[plr]){
        if (this['state']=='grab'){

        }
        if (this['state']!=['grabjump', 'grab']){
            this.walljump();
        }
    }

    
}