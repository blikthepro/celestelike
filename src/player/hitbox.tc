extend plr{
    function hitbox(this:var[plr]){
        line boxPoints=[vec(.2,  .45, .2), vec(-.2, .45, .2), vec(.2, -.45, .2), vec(.2, .45, -.2), vec(-.2, -.45, .2), vec(-.2, .45, -.2), vec(.2, -.45, -.2), vec(-.2, -.45, -.2)];
        line nest:list[list[str]]=[
            ['death', 'small_amethyst_bud', 'medium_amethyst_bud', 'large_amethyst_bud', 'amethyst_cluster', 'pointed_dripstone'], 
            ['spring', 'piston'], 
            ['bumper', 'prismarine', 'purpur_block'], 

        ];

        
        
        for (line v of boxPoints){
            line pos:loc=loc.shiftOnVector (selected.midpointLocation,  v as vec);
            //allPlayers.displayParticleEffect(par('trail',  duration=1,  color='#fc7812'), loc.shiftOnVector(selected.midpointLocation, v as vec));
            if (game.locationIsInBlock (pos)){
                for (line ls of nest){
                    if(ls.contains (game.getBlockMaterial (pos , returnValue= "Block ID (oak_log)"))){
                        line caller= ls.get (1);
                        call "%var(caller)";
                        break;
                    }
                }
            }
        }
        
    }


}

