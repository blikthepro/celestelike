extend plr{
    function wave  (this:var[plr]){
        if (default.isGrounded()){
            if (this['refillDash']=='true' && this['dashes']<this['maxdashes']){
                this['dashes']=this['maxdashes'];
        }
        }
        wait  ();
        if !(this['state']=='dashing'){
            return;
        }
        line requiredSpeed:num=.3;

        if  (vec.len  (vec  (default.velocity.x,0,default.velocity.z))<requiredSpeed){
            return;
        }
        if  (var.isInRange (this['dashAngle'],-15,19.999)){
            default.setVelocity ( (vec (default.velocity.x,.3,default.velocity.z)+vec (default.direction.x,0,default.direction.z))*1.1,addToCurrentVel="False");
            allPlayers.playSound (csnd ("celestelike:super"),default.location,source="Players");
        }
        if  (this['dashAngle']>=20){
            default.setVelocity ( (vec (default.velocity.x,.15,default.velocity.z)+vec (default.direction.x,0,default.direction.z))*1.2,addToCurrentVel="False");
            allPlayers.playSound (csnd ("celestelike:hyper"),default.location,source="Players");
        }
        this['state']="hwipping";
        
        start this.waveParticle (this);
    }
}