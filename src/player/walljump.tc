extend plr{
    function walljump  (this:var[plr]){

        if   (default.isGrounded  ()){
            return;
        }
        if   (default.isSwimming ()){
            return;
        }
        if  (['walljump','climbjumping','dreaming'].contains (this['state'])){
            return;
        }
        

        line wjpoints= [vec (.5,0,0),vec (0,0,.5),vec (-.5,0,0),vec (0,0,-.5)];
        for  (line p of wjpoints){

            p=loc.shiftOnVector (default.midpointLocation,p as vec);

            if  (game.locationIsInBlock (p as loc)){
                if (this['state']=='climbing'){
                this.climbJump (p as loc);
                return;
            }
                //sound and block fracture
                if  (this['state']=="dashing"){
                    allPlayers.playSound (snd2 ("celestelike:wallbounce",1,.5), p as loc);
                }
                else{
                    allPlayers.playSound (snd2 ("celestelike:walljump",1,.5), p as loc);
                }
                allPlayers.playSound (snd.setVolume (snd.setPitch (game.getBlockSound (game.getBlockMaterial (p as loc, returnValue="Item"),soundType="Break Sound"),0.75), 2),p as loc);
                allPlayers.displayBlockFracture (p as loc,num.random (1,7), overwritePrevious="True");


                //clamps your y velocity
                default.setVelocity (vec (
                    default.velocity.x,
                    num.clamp (
                        default.velocity.y,0,0.4),
                    default.velocity.z));
                this['state']='walljump';
                        //this gives you the impulse based on your input
                if  (list.contains (default.pressedMovementKeys, ['forward','backward','left','right'])){
                    default.launchTowardLocation (p as loc,-40, ignoreDistance="True");
                    default.launchUp (7);
                }
                else{
                    default.launchTowardLocation (p as loc,-20, ignoreDistance="True");
                    default.launchUp (7);
                }
                start this.delayedStateReset (this,5);
            }
        }
    }
    
    function climbJump (this:var[plr],p:loc){
        this['state']='climbjumping';
        default.launchUp (6,addToCurrentVel="False");
        start this.delayedStateReset (this,10);
        this['stamina']-=25;
        allPlayers.playSound (snd2 ("celestelike:climbjump"),default.location);
        allPlayers.playSound (snd.setVolume (snd.setPitch (game.getBlockSound (game.getBlockMaterial (p as loc, returnValue="Item"),soundType="Break Sound"),0.75), 2),p as loc);
        allPlayers.displayBlockFracture (p as loc,num.random (1,7), overwritePrevious="True");
        wait (10);
        if (vec.len (vec.between (loc.setCoordinate (default.location, 0, coord="Y"),loc.setCoordinate (p, 0, coord="Y")))>.7){
            this['stamina']+=25;
        }
    }
}