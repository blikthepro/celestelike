extend plr{
    //note: add afterimages later
    process dashParticle (this:var[plr]){
        wait (1);
        line oldLoc=default.location;
        repeat (10){
            allPlayers.displayParticleLine(par("trail",color='#ffffff',motion=default.velocity),oldLoc,default.location);
            allPlayers.displayParticleLine(par('entity_effect',color=dashcolors[this['dashes']+1]as str,motionVariation=0),oldLoc,default.location);
           
            oldLoc=default.location;
            wait (1);
        }
    }
    //finished
    process waveParticle (this:var[plr]){
        wait (1);
        repeat (5){
            allPlayers.displayParticleCircle (par ("end_rod", motion=vec(0,0,0), motionVariation=0),loc.shiftRotation (loc.setDirection (default.midpointLocation,default.velocity),90,rotationAxis="Pitch"), 1.5);
            wait (3);
        }
    }
}