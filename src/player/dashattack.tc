extend plr{
    process dashAttack(this:var[plr]){
        line nest:list[list[str]]=[
            ['dreamBlock','tinted_glass']

        ];
 //raycast as an alternative way to interact with stuff. i think only dream blocks use dash attack
 //muuuuch more smoother than putting these in the hitbox code


        line rayLoc:loc=game.raycast(default.eyeLocation,3,blockCollision="Solid blocks");

        for (line ls of nest){
            if(ls.contains(game.getBlockMaterial(rayLoc,returnValue="Block ID (oak_log)"))){
                line caller:str= ls.get(1);
                call "%var(caller)"(this,rayLoc);
            }
        }
    }
}