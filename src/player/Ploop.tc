function Ploop(){
    if !(selected.isInGameMode(gamemode="Adventure")){
        return;
    }
    global "%uuid".ticker();//tick timers
    if (player.isGrounded()){
        
        global "%uuid".filteredRegen();//regen if grounded
        global "%uuid"['airJumps']=0;
    }
    global "%uuid".hud();//update hud
    selected.setMovementAttribute(1-2*vec.len(vec(selected.velocity.x,0,selected.velocity.z)), attr="Friction modifier");//set friction inverse to speed
    if (selected.isSneaking()){
        global "%uuid".climb();//climb if sneaking
    }
    global "%uuid".hitbox();//hitbox procedure
}


