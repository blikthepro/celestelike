extend plr{
    function climb(this:var[plr]){
        if(this['stamina']<=0){
            return;
        }

        if(['exhausted','feather','climbjumping','climbing'].contains(this['state'])){
            return;
        }

        line climbPoints= [vec(.5,0,0),vec(0,0,.5),vec(-.5,0,0),vec(0,0,-.5)];
        line slippies=[item('ice'), item("packed_ice"),item('blue_ice')];

        for (line p of climbPoints){
            line l=loc.shiftOnVector(selected.midpointLocation,p as vec);
            if (game.locationIsInBlock(l)){
                if (game.blockEquals(l,slippies as item)){
                    continue;
                }
                else{
                    this['state']='climbing';
                    allPlayers.playSound(snd.setVolume(snd.setPitch(game.getBlockSound(game.getBlockMaterial(l as loc, returnValue="Item"),soundType="Hit Sound"),0.75), 3),l as loc);
                    start this.climbing(this,p as vec, targetMode="With current selection");
                    break;
                }
            }
        }
        
    }
    process climbing(this:var[plr], climbDir:vec){
        selected.setVelocity(vec(selected.velocity.x, 0, selected.velocity.z), addToCurrentVel="False");
        selected.setFallingAttribute(0,attr="Gravity");
        while (this['stamina']>0){
            if (!selected.isSneaking()){
                this['state']='normal';

                break;
            }
            if(!game.locationIsInBlock(loc.shiftOnVector(selected.midpointLocation,climbDir))){
                break;
            }

            if(!game.locationIsInBlock(selected.standingBlockLocation)){
                this['stamina']as num--;
            }
            if (this['state']=='climbjumping'){
                break;
            }

            if(selected.pressedMovementKeys.contains(['forward','backward','left','right'], checkMode="Has Any Value")){
                line angle:num= vectorAngle(this.wishdir(),climbDir);

                if(var.isInRange(angle,0,45)){
                    selected.setVelocity(vec(selected.velocity.x,.15,selected.velocity.z), addToCurrentVel="False");
                    this['stamina'] as num--;
                }
                if(var.isInRange(angle,46,135)){
                    if(vec.len(vec(selected.velocity.x,0,selected.velocity.z))<=.2){
                        line sidewaysClimb:vec=vec.setLength(vec.align(this.wishdir()),.2);
                        selected.setVelocity(vec(sidewaysClimb.x, selected.velocity.y,sidewaysClimb.z), addToCurrentVel="False");
                    }
                }
                if(var.isInRange(angle,136,180)){
                    selected.setVelocity(vec(selected.velocity.x,-.15,selected.velocity.z), addToCurrentVel="False");
                    this['stamina'] as num++;
                }

            }
            else{
                selected.setVelocity(vec(selected.velocity.x,0,selected.velocity.z), addToCurrentVel="False");
            }




        wait();
        }
        if (this['stamina']==0){
            this['state']='exhausted';
        }
        selected.setFallingAttribute(0.08,attr="Gravity");
    }
}