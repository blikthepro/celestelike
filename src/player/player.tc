type plr:{
    name:str,
    maxdashes:num,
    dashes:num,
    airJumps:num,
    maxstamina:num,
    stamina:num,
    state:str,
    refillDash:str,
    refillStam:str,
    dashAngle:num,
    timers:dict[num]

};

extend plr{
    function constructor(): plr {

        line p = {
            name:'%uuid',
            maxdashes:1,
            dashes:1,
            airJumps:0,
            maxstamina:110,
            stamina:110,
            state:"normal",
            refillDash:'true',
            refillStam:'true',
            timers:{}
        } as plr;
        return p;
    }
    //some of these should be moved to their own files and leave the constructor alone
    function ticker(this:var[plr]){
//you can add a timer in this by doing this['timers'][blahblah]=number; but the hitbox code automatically handles it
        for(line key, line value of this['timers']){
            
            if (value>0){
                this['timers'][key]--;
            }
            else{
                line temp=this['timers'];
                temp.remove(key);
                this['timers']=temp;
            }
        }
    }

    process delayedStateReset(this:var[plr],time:num){
        line temp= this['state'];
        wait(time);
        if (this['state']==temp){
            this['state']='normal';
        }
    }

    function dash(this:var[plr]){
     //this is how you make the class method work, no other way as far as i can tell
        if (this['state']=='boosting'){
            this["state"]='quickexit';
            return;
        }
        if (this['state']=='dead'||this['dashes']<1){
            return;
        }
        
        this['state']='dashing';
        this['dashes']--;
        
        this['dashAngle']=default.pitch;
        line dir=default.direction;
        if (default.isGrounded() && this['dashAngle']>0 ){
                dir=vec(default.direction.x,0,default.direction.z);
        }

        default.setVelocity(vec.setLength(dir, num.clamp(vec.len(vec(default.velocity.x,0,default.velocity.z)),1,1000)));
        if !(default.isGrounded()){
            this['dashAngle']=default.velocity.angle(default.velocity.setComponent(0,comp="Y"));
        }
  
        
        allPlayers.playSound(csnd("celestelike:dash"), default.location,source="Players");
        start this.delayedStateReset(this,10);
        start this.dashParticle(this);
        start this.dashAttack(this);
    }

    

    function filteredRegen(this:var[plr]){
        if (['dashing','dead'].contains(this['state'],checkMode="Has Any Value")){
            return;
        }
        
        if (this['refillDash']=='true' && this['dashes']<this['maxdashes']){
                this['dashes']=this['maxdashes'];
        }
        if (this['refillStam']=='true' && this['stamina']<this['maxstamina']){
                this['stamina']=this['maxstamina'];
        }
        this['state']='normal';
    }



    function jumpKeyFilter(this:var[plr]){
            this.walljump();
            if(this['airJumps']>0){
                this['airJumps']--;
                this.airJump();
            }
    }

    
}