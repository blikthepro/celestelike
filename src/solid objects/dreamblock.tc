function dreamBlock(this:var[plr],rayLoc:loc){ //this is the funny dream block function
    this['state']='dreaming';
    allPlayers.displayParticleCircle(par('note',color='#9400d3',colorVariation=5),rayLoc.shiftRotation(90,rotationAxis="Pitch"));

    line finalLoc:loc=game.raycast(default.eyeLocation,3,blockCollision="None");
    allPlayers.playSound(csnd('celestelike:blocks.dreamenter'),default.location,source="Players");
    while(!game.blockEquals(finalLoc,'air')){
        finalLoc=game.raycast(finalLoc,1,blockCollision="None",entityCollision="False");
        allPlayers.displayParticleEffect(par('dripping_obsidian_tear'),finalLoc);
    }
    //all this is particles, it only raycasts through the block once. needs fixing because if it never reaches air it crashes



    finalLoc=game.raycast(finalLoc,1,blockCollision="None",entityCollision="False");
    line finalVec:vec=vec.between(default.eyeLocation,finalLoc);
    //launches the player along the vector forged by their initial loc and the raycasted loc. this way the player can "drift" a little and influence their position in the block
    default.setToSpectatorMode();
    allPlayers.playSound(csnd('celestelike:blocks.dreamtravel'),default.location,source="Players");
    while(game.blockEquals(default.eyeLocation,'air')){

        default.setVelocity(finalVec.setLength(.75),addToCurrentVel="False");
        default.launchForward(2,addToCurrentVel="True");
        wait;
    }
    while(!game.blockEquals(default.eyeLocation,'air')){

        default.setVelocity(finalVec.setLength(.75),addToCurrentVel="False");
        default.launchForward(2,addToCurrentVel="True");
        wait;
    }

    //pushes the player until they're in the block, then out, then for 2 more ticks so they dont get stuck in edge cases
    repeat(2){
        default.setVelocity(finalVec.setLength(.75),addToCurrentVel="False");   
        default.launchForward(2,addToCurrentVel="True");
        wait;
    }

    allPlayers.stopSounds(csnd('celestelike:blocks.dreamtravel'));
    allPlayers.playSound(csnd('celestelike:blocks.dreamexit'),default.location,source="Players");
    default.setToAdventureMode();
    this.filteredRegen();
}