extend plr{
    function wave(this:var[plr]){
        line requiredSpeed:num=.4;
        if (this["state"]=='hwipping'){
            requiredSpeed==1;
        }
        if(vec.len(vec(default.velocity.x,0,default.velocity.z))<requiredSpeed){
            return;
        }
        if (var.isInRange(this['dashAngle'],-15,19.999)){
            default.setVelocity((vec(default.velocity.x,-1,default.velocity.z)+default.direction)*1.5,addToCurrentVel="False");
            allPlayers.playSound(snd2("celestelike:super"),default.location);
        }
        if (this['dashAngle']>=20){
            default.setVelocity((vec(default.velocity.x,0,default.velocity.z)+default.direction)*2,addToCurrentVel="False");
            allPlayers.playSound(snd2("celestelike:hyper"),default.location);
        }
        this['state']="hwipping";
        start this.waveParticle(this);
    }
}