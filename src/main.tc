
gameevent startup{
    declare global dashcolors=['#44B7FF','#AC3232','#FF6DEF','#1141df','#ff00ff','#ffff00'];
    start Gloop();
}


playerevent join{
    default.setMiscellaneousAttribute(.5,attr="Scale");
    default.setMovementAttribute(125,attr="Jump strength",valueType="Percentage (Base)");
    default.setToAdventureMode();
    default.disableBlockModification();
    default.setPvPAllowed(pvp="Disable");
    default.setCollidable(collision="Disable");
    default.setDeathDropsEnabled(spawnDrops="Disable");
    declare global "%uuid"=plr(); //need to test in multiplayer to make sure this isn't acting up
    default.sendResourcePack('https://cdn.minepack.fr/pack/c78e10fe-881a-4818-a73a-ba95f8bc3a2d'); 
}        //management link is https://minepack.fr/manage/c78e10fe-881a-4818-a73a-ba95f8bc3a2d/b2279a1a-e877-412b-b168-9d337cd21c1f

playerevent leftClick{
    global "%uuid".dash();
    
}

playerevent exhaustion{
    event.cancel();
}

playerevent takeDamage{
    event.cancel();
}

playerevent movementKeyChange{
    if (event.movementKeyEquals(key="Jump (Space)")){
        global "%uuid".jumpKeyFilter();
    }
}
playerevent jump{
    if (list.contains(default.pressedMovementKeys, 'jump')){
        global "%uuid".wave();
    }
}