
gameevent startup{
    start Gloop();
}


playerevent join{
    declare global "%uuid"=plr();
    default.sendResourcePack('https://minepack.fr/pack/aaa28982-1e2f-4b0a-b9bf-3242f68f3d7a');
}

playerevent leftClick{
    global "%uuid".dash();
    
}

playerevent exhaustion{
    event.cancel();
}

playerevent takeDamage{
    event.cancel();
}

