function feather(feather:item){
    line featherTimer=60;
    if (global "%uuid"['state']=='feather'){
        global "%uuid"['timers']['feather']=featherTimer;
        call respawnItem(feather);
        return;
    }
    global "%uuid".filteredRegen();
    global "%uuid"['state']='feather';
    global "%uuid"['timers']['feather']=featherTimer+5;
    allPlayers.playSound(csnd("celestelike:pickups.featherget"),victimEntity.location,source="Blocks");
    default.setFallingAttribute(0,attr="Gravity");

    repeat(5){
        default.setVelocity(default.velocity*0.75);
        default.setBossBar(s'<gold>feather',global "%uuid"['timers']['feather'],featherTimer,color="Yellow",style="6 segments");
        wait;
    }
    default.setEquipmentItem(item("elytra"),slot="Chest");
    default.setGliding(gliding="Enable");
    allPlayers.playSound(csnd("celestelike:pickups.featherloop"),default.location,source="Players");
    default.givePotionEffect(pot("glowing",0,featherTimer));
    default.setNameColor(color="Gold");
    while(global "%uuid"['timers']['feather']>0){
        default.launchForward(5,addToCurrentVel="False");
        default.setBossBar(s'<gold>feather',global "%uuid"['timers']['feather'],featherTimer,color="Yellow",style="6 segments");
        if (global "%uuid"["state"]=='quickexit'){
            global "%uuid".dash();
            break;
        }
        wait;
    }
    default.removeBossBar();
    default.clearInventory();
    default.setGliding(gliding="Disable");
    default.setFallingAttribute(0.08,attr="Gravity");
    allPlayers.stopSounds(csnd("celestelike:pickups.featherloop"),source="Players");
    allPlayers.playSound(csnd("celestelike:pickups.featherend"),default.location,source="Players");
}