function initObjects(){
    declare global objects:dict[{name: txt, mode: str, any...}]={
        //"mode" is what function will be called to handle the object init.


        refill:{
            name: s'<#00ff00>Refill',
            mode:'item',
            displayItem:litem("wa", "refill"),
            glowColor:'Green'
        },
        double_refill:{
            name: s'<#ff00ff>Double Refill',
            mode:'item',
            displayItem:litem("wa", "double_refill"),
            glowColor:'Light purple'
        },
        triple_refill:{
            name: s'<#0000ff>Triple Refill',
            mode:'item',
            displayItem:litem("wa", "triple_refill"),
            glowColor:'Dark blue'
        },
        jump_refill:{
            name: s'<cyan>Jump Refill',
            mode:'item',
            displayItem:litem("wa", "jump_refill"),
            glowColor:'Cyan'
        },
        auto_jump:{
            name: s'Auto Jump',
            mode:'item',
            displayItem:litem("wa", "auto_jump"),
            glowColor:'Dark purple'
        },

        feather:{
            name: s'<#ffff00>Golden Feather',
            mode:'item',
            displayItem:item("feather"),
            glowColor:'Gold'
        },
        green_booster:{
            name: s'<#00ffff>Green Bubble',
            mode:'booster',
            entity:'green',
            displayBlock:item("cyan_stained_glass")
        },
        red_booster:{
            name: s'<#ff0000>Red Bubble',
            mode:'booster',
            entity:'red',
            displayBlock:item("red_stained_glass")
        }
    };

    for (line i of saved eLocs){ //works for now, no need to change it unless a later entity requires new parameters
        declare local ls:list =i as list; //
        line mode= objects[ls[2] as str]['mode'];
        call '%var(mode)_constructor'(ls[1] as loc, objects[ls[2] as str] as dict);
    }
}

